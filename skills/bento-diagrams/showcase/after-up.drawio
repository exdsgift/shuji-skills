 edge="1" source="skylet" target="up" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="840" y="336"/><mxPoint x="840" y="184"/></Array></mxGeometry></mxCell><mxCell id="e-fail-access" value="" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#FFFFFF,#000000);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="col-access" target="fail" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="420"/><mxPoint x="420" y="420"/></Array></mxGeometry></mxCell><mxCell id="e-fail-start" value="" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#FFFFFF,#000000);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="col-start" target="fail" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="420"/><mxPoint x="420" y="420"/></Array></mxGeometry></mxCell><mxCell id="e-fail-prepare" value="still fails" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#FFFFFF,#000000);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;overflow=fill;" edge="1" source="col-prepare" target="fail" parent="1"><mxGeometry height="13" width="56" x="0.4" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="caption1" value="Once the instances run, SkyPilot waits for SSH on every node, which Kubernetes and Slurm skip, and starts the Docker container when the task names an image." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="568" width="1080" height="18" as="geometry"/></mxCell><mxCell id="caption2" value="It copies the cloud credentials and its wheel to every node and runs the setup commands there, then starts Ray on the head and the workers and skylet on the head." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="590" width="1080" height="18" as="geometry"/></mxCell><mxCell id="caption3" value="Success records the cluster as UP and marks it ever up; a step that still fails ends the launch with no failover, and the cluster stays INIT." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="612" width="1080" height="18" as="geometry"/></mxCell><mxCell id="lg-a-step" value="" style="rounded=1;arcSize=30;fillColor=light-dark(#FFFFFF,#2C2C2E);strokeColor=light-dark(#D1D1