<mxCell id="c339" value="Five stores speak the S3 API and share its tools: aws s3 sync uploads and copies, goofys mounts (rclone on ARM), and rclone serves MOUNT_CACHED with a disk cache per mount." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="1152" width="1057" height="20" as="geometry"/></mxCell>
<mxCell id="c340" value="The other five bring their own: gsutil and gcsfuse, az, blobfuse2 and azcopy, rclone for IBM COS, the oci CLI with rclone, and huggingface_hub with hf-mount; IBM COS has no MOUNT_CACHED." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="1174" width="1136" height="20" as="geometry"/></mxCell>
<mxCell id="c341" value="Uploads run where the API server runs; every mount and every copy runs on each node of the cluster." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="1196" width="599" height="20" as="geometry"/></mxCell>
