css2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;endSize=5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="down" target="f-probe"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="564"/><mxPoint x="1224" y="564"/></Array></mxGeometry></mxCell><mxCell id="b16" value="" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;endSize=5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="down" target="removed"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="564"/><mxPoint x="1464" y="564"/></Array></mxGeometry></mxCell><mxCell id="b17" value="" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;endSize=5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="down" target="f-prov"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b18" value="" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;endSize=5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="preempted" target="removed"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="cap0" value="A scale up adds a replica as PENDING until a launch slot frees; once sky launch succeeds it is STARTING until its readiness probe passes, then READY or NOT_READY with each probe, every 10 s." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="696" width="1136" height="20" as="geometry"/></mxCell><mxCell id="cap1" value="A preempted spot replica shows PREEMPTED while it is torn down; every other way out shows SHUTTING_DOWN while sky down runs, after a 120 s drain on a scale down." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="718" width="1005" height="20" as="geometry"/></mxCell><mxCell id="cap2" value="Then a scaled-down or preempted replica leaves the table, a failed one keeps its code and still counts as a replica, and FAILED_CLEANUP means sky down itself failed. The initial delay is 1200 s by default." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColo