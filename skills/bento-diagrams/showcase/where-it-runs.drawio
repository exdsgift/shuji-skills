eStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="c58" target="c74" parent="1"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="656" y="428"/></Array></mxGeometry></mxCell><mxCell id="e133" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.528;entryDx=0;entryDy=0;" edge="1" source="c14" target="c20" parent="1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c134" value="The sky CLI calls the Python SDK; the SDK and the dashboard call one FastAPI server over HTTP, either a local one that the first call starts at 127.0.0.1:46580, or a deployed one behind the operator's auth." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="636" width="1188" height="20" as="geometry"/></mxCell><mxCell id="c135" value="Each call becomes a request in requests.db and waits in the long or the short queue for a worker; a launch runs in a long worker, which provisions on the clouds and records the cluster in the state database." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="658" width="1201" height="20" as="geometry"/></mxCell><mxCell id="c136" value="A local server keeps its queues in its own process and runs at most four long workers; a deployed one runs a server process per CPU and a queue manager on port 50011." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="680" width="995" height="20" as="geometry"/></mxCell><mxCell id="c137" value="" style="rounded=1;arcSize=30;fillColor=light-dark(#FFFFFF,#2C2C2E);strokeColor=light-dark(#D1D1D6,#3A3A3C);" vertex="1" parent="1"><mxGeometry x="20" y="724" width="28" height="18" as="geometry"/></mxCell><mxCell id="c138" value="a part of SkyPilot or a provider" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="56" y="723" width="168" height="20" as="geometry"/></mxCell><mxCell id="c139" value="" style="rounded=1;arcSize=30;fillColor=light-dark(#FFFFFF,#2C2C2E);strokeColor=light-dark(#FF9500,#FF9F0A);strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="252" y="724" width="28" height="18" as="geometry"/></mxCell><mxCell id="c140" value="turned on by the operator" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="288" y="723" width="145" height="20" as="geometry"/></mxCell><mxCell id="e141" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="461" y="733" as="sourcePoint"/><mxPoint x="489" y="733" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c142" value="a call or a hand-off" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="497" y="723" width="106" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
