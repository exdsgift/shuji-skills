Color=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);labelBackgroundColor=light-dark(#FFFFFF,#000000);exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;overflow=fill;" edge="1" source="blocked" target="none" parent="1"><mxGeometry height="13" width="101" x="0.464" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="fails" value="fails" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);labelBackgroundColor=light-dark(#FFFFFF,#000000);exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;overflow=fill;" edge="1" source="prov" target="block" parent="1"><mxGeometry height="13" width="37" x="0.488" relative="1" as="geometry"><Array as="points"><mxPoint x="1412" y="184"/><mxPoint x="1412" y="588"/></Array></mxGeometry></mxCell><mxCell id="loop" value="optimize again" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);labelBackgroundColor=light-dark(#FFFFFF,#000000);strokeColor=light-dark(#FFCC00,#FFD60A);dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;overflow=fill;" edge="1" source="block" target="blocked" parent="1"><mxGeometry height="13" width="90" x="-0.906" relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="472"/><mxPoint x="474" y="472"/></Array></mxGeometry></mxCell><mxCell id="cap0" value="The optimizer rechecks a named cloud that is not enabled, then asks each enabled cloud, in parallel, for the cheapest catalog type that meets the request and its features, as one candidate per region, or per zone for spot." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="644" width="1293" height="20" as="geometry"/></mxCell><mxCell id="cap1" value="It drops what the blocklist matches, scores the rest by price for the runtime times the nodes not already reserved, or by runtime alone, and solves a chain of tasks by dynamic programming and any other DAG by an ILP, egress included." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="666" width="1378" height="20" as="geometry"/></mxCell><mxCell id="cap2" value="A launch that fails blocks its zone, region or cloud and runs the optimizer again; once no candidate is left, the launch stops with an error that asks to relax the request." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="688" width="972" height="20" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;arcSize=30;fillColor=light-dark(#FFFFFF,#2C2C2E);strokeColor=light-dark(#D1D1D6,#3A3A3C);strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="732" width="28" height="18" as="geometry"/></mxCell><mxCell id="lg0_w" value="a step" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="56" y="732" width="37" height="18" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;arcSize=30;fillColor=light-dark(#FFFFFF,#2C2C2E);strokeColor=light-dark(#34C759,#30D158);strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="121" y="732" width="28" height="18" as="geometry"/></mxCell><mxCell id="lg1_w" value="the cluster is up" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="157" y="732" width="91" height="18" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;arcSize=30;fillColor=light-dark(#FFFFFF,#2C2C2E);strokeColor=light-dark(#FF3B30,#FF453A);strokeWidth=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="276" y="732" width="28" height="18" as="geometry"/></mxCell><mxCell id="lg2_w" value="the launch stops" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="312" y="732" width="95" height="18" as="geometry"/></mxCell><mxCell id="lg3" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="435" y="741" as="sourcePoint"/><mxPoint x="463" y="741" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg3_w" value="the flow" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="471" y="732" width="49" height="18" as="geometry"/></mxCell><mxCell id="lg4" value="" style="edgeStyle=none;rounded=0;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;strokeColor=light-dark(#FFCC00,#FFD60A);dashed=1;dashPattern=6 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="548" y="741" as="sourcePoint"/><mxPoint x="584" y="741" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lg4_w" value="blocked, then optimized again" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="592" y="732" width="169" height="18" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
