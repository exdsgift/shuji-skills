ntFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeColor=light-dark(#FFCC00,#FFD60A);dashed=1;dashPattern=6 4;overflow=fill;" edge="1" source="c46" target="c51" parent="1"><mxGeometry height="13" width="89" x="-0.3774" relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="276"/></Array></mxGeometry></mxCell><mxCell id="e77" value="returns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;overflow=fill;" edge="1" source="c51" target="c56" parent="1"><mxGeometry height="13" width="53" x="0.3774" relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="500"/></Array></mxGeometry></mxCell><mxCell id="e78" value="raises" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;overflow=fill;" edge="1" source="c51" target="c61" parent="1"><mxGeometry height="13" width="46" x="0.3774" relative="1" as="geometry"><Array as="points"><mxPoint x="744" y="500"/></Array></mxGeometry></mxCell><mxCell id="e79" value="from any active state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;overflow=fill;" edge="1" source="c36" target="c66" parent="1"><mxGeometry height="13" width="121" x="0.4118" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c80" value="The SDK posts the call and gets its request ID back at once; the endpoint stores the request in requests.db as PENDING and puts it in the long or the short queue." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="576" width="951" height="20" as="geometry"/></mxCell><mxCell id="c81" value="A free worker runs it, writing its output to request_logs/&lt;id&gt;.log, which /api/stream follows; a retryable error parks it as WAITING and puts it back in its queue once the backoff ends." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="598" width="1060" height="20" as="geometry"/></mxCell><mxCell id="c82" value="/api/get waits for a finished status, then returns the value or raises the error. sky api cancel, a short request itself, sends SIGTERM to any worker running it; Ctrl-C on the CLI does not cancel." style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="20" y="620" width="1110" height="20" as="geometry"/></mxCell><mxCell id="c83" value="" style="rounded=1;arcSize=30;fillColor=light-dark(#FFFFFF,#2C2C2E);strokeColor=light-dark(#D1D1D6,#3A3A3C);" vertex="1" parent="1"><mxGeometry x="20" y="664" width="28" height="18" as="geometry"/></mxCell><mxCell id="c84" value="a call, or a state and its status code" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="56" y="663" width="192" height="20" as="geometry"/></mxCell><mxCell id="c85" value="" style="rounded=1;arcSize=30;fillColor=light-dark(#FFFFFF,#2C2C2E);strokeColor=light-dark(#34C759,#30D158);strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="276" y="664" width="28" height="18" as="geometry"/></mxCell><mxCell id="c86" value="finished with a value" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="312" y="663" width="115" height="20" as="geometry"/></mxCell><mxCell id="c87" value="" style="rounded=1;arcSize=30;fillColor=light-dark(#FFFFFF,#2C2C2E);strokeColor=light-dark(#FF3B30,#FF453A);strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="455" y="664" width="28" height="18" as="geometry"/></mxCell><mxCell id="c88" value="stopped by an error or a cancel" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="491" y="663" width="173" height="20" as="geometry"/></mxCell><mxCell id="c89" value="" style="rounded=1;absoluteArcSize=1;arcSize=10;fillColor=light-dark(#FF9500,#FF9F0A);strokeColor=none;" vertex="1" parent="1"><mxGeometry x="692" y="664" width="18" height="18" as="geometry"/></mxCell><mxCell id="c90" value="" style="shape=image;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="695" y="667" width="12" height="12" as="geometry"/></mxCell><mxCell id="c91" value="waits out a backoff" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="718" y="663" width="107" height="20" as="geometry"/></mxCell><mxCell id="e92" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=24;endArrow=block;endFill=1;endSize=5;strokeColor=light-dark(#AEAEB2,#8E8E93);strokeWidth=1.5;fontSize=11;fontColor=light-dark(#48484A,#D1D1D6);labelBackgroundColor=light-dark(#F2F2F7,#1C1C1E);html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="853" y="673" as="sourcePoint"/><mxPoint x="881" y="673" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c93" value="the event that moves it on" style="html=0;fontFamily=Instrument Sans;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss2%3Ffamily%3DInstrument%2BSans%3Awght%40400%3B600;text;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=light-dark(#6E6E73,#98989F);" vertex="1" parent="1"><mxGeometry x="889" y="663" widt